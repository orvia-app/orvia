# Future server-side placeholders only.
# Do not commit real secrets, tokens, webhook secrets, or production values.
# Copy this file to .env.local for local development when backend services exist.

# AI provider key. Server-side only.
OPENAI_API_KEY=

# Future Supabase configuration.
# SUPABASE_ANON_KEY may become public only after RLS/security review.
# Service-role keys must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future Stripe server-side configuration.
# Do not store card data in the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Future browser-safe publishable key, if Stripe Checkout/Elements is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
