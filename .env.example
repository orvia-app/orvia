# Future server-side placeholders only.
# Do not commit real secrets, tokens, webhook secrets, or production values.
# Copy this file to .env.local for local development when backend services exist.

# Future browser-visible Supabase config.
# These are public only after Supabase RLS/security review.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future Supabase service key. Server-side only.
# Never expose this to browser code, NEXT_PUBLIC_ variables, logs, or screenshots.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider key. Server-side only.
OPENAI_API_KEY=

# Future Telegram bot token. Server-side only.
TELEGRAM_BOT_TOKEN=

# Future Stripe server-side configuration.
# Do not store card data in the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Future browser-safe publishable key, if Stripe Checkout/Elements is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Runtime ownership verification test accounts.
# Use disposable Supabase Auth users only. Do not commit real credentials.
ORVIA_RUNTIME_USER_A_EMAIL=
ORVIA_RUNTIME_USER_A_PASSWORD=
ORVIA_RUNTIME_USER_B_EMAIL=
ORVIA_RUNTIME_USER_B_PASSWORD=
